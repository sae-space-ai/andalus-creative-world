# ANDALUS CREATIVE WORLD — Variables de Entorno
# Copia este archivo como .env y completa los valores

# ============================================================
# BASE DE DATOS
# ============================================================
DATABASE_URL=postgresql://andalus:andalus_dev_password@localhost:5432/andalus_creative_world

# ============================================================
# SERVIDOR API
# ============================================================
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ============================================================
# FRONTEND
# ============================================================
FRONTEND_URL=http://localhost:3000

# ============================================================
# SEGURIDAD
# ============================================================
# Mínimo 32 caracteres. Generar con: openssl rand -hex 32
COOKIE_SECRET=change-this-in-production-min-32-chars!!

# ============================================================
# CORREO (SMTP)
# ============================================================
# Para desarrollo local con Mailpit:
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@andalus-creative-world.dev

# Para producción (ejemplo Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# ============================================================
# GOOGLE OIDC (opcional)
# ============================================================
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# ============================================================
# STRIPE (opcional, modo TEST)
# ============================================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================
# ALMACENAMIENTO
# ============================================================
UPLOAD_DIR=./uploads

# ============================================================
# SERVICIOS EXTERNOS (futuro)
# ============================================================
# AI_ENGINE_URL=
# VIDEO_PROVIDER_KEY=
# AUDIO_PROVIDER_KEY=
